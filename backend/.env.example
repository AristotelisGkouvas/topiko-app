# --- Database ---
DATABASE_URL=postgresql+asyncpg://pamesentra:pamesentra@localhost:5432/pamesentra

# --- App ---
APP_NAME=Pame Gipedo API
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Scraper ---
# Put a real contact address here before running against a live site.
# ASCII only — this becomes an HTTP header value.
SCRAPER_USER_AGENT=PameSentraBot/0.1 (+mailto:you@example.com; aggregator for Greek amateur football results)

# --- Auth (Phase 3, not used yet) ---
# JWT_SECRET=change-me
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
