# Ρυθμίσεις του docker compose. Αντίγραψέ το σε .env (δεν μπαίνει στο git).

# --- Βάση ---------------------------------------------------------------
POSTGRES_PASSWORD=pamesentra
DATABASE_URL=postgresql+asyncpg://pamesentra:pamesentra@db:5432/pamesentra

# --- API ----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# Από πού επιτρέπεται να καλεί ο browser το API. Η διεύθυνση του site.
CORS_ORIGINS=http://localhost:3000

# --- Scraper ------------------------------------------------------------
# ΥΠΟΧΡΕΩΤΙΚΟ: το compose αρνείται να σηκώσει τον scraper χωρίς αυτό.
# Πρέπει να κατονομάζει το project και να δίνει πραγματικό τρόπο επικοινωνίας —
# ένας webmaster ένωσης που θέλει να σταματήσει αυτό δεν πρέπει να μαντεύει
# ποιος ρωτάει. Μόνο ASCII: οι τιμές HTTP headers είναι latin-1 στην καλύτερη.
SCRAPER_USER_AGENT=PameSentraBot/0.1 (+mailto:CHANGE-ME@example.com; aggregator for Greek amateur football results)
SCRAPER_LIVE_INTERVAL_SECONDS=300
SCRAPER_IDLE_INTERVAL_SECONDS=21600

# --- Site ---------------------------------------------------------------
# ΠΡΟΣΟΧΗ: build-time. Το Next τα ενσωματώνει στο client bundle, οπότε αλλαγή
# εδώ θέλει `docker compose build web`, όχι απλό restart. Και πρέπει να είναι
# η διεύθυνση που λύνει ο browser του αναγνώστη — όχι το hostname του compose.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ASSOCIATION=epsip-ipeirou
